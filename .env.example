# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_MAPS_PLATFORM_KEY: Required for Google Maps features.
# Get a key: https://console.cloud.google.com/google/maps-apis/start
GOOGLE_MAPS_PLATFORM_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# API configuration
VITE_API_BASE_URL="/api"

# AUTH0 configuration
VITE_AUTH0_DOMAIN=""
VITE_AUTH0_CLIENT_ID=""
VITE_AUTH0_AUDIENCE=""

# DB configuration (PostgreSQL)
DATABASE_URL="postgres://user:password@localhost:5432/margrakshak"
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="postgres"
DB_PASSWORD="yourpassword"
DB_NAME="margrakshak"

# WAZE INTEGRATION
WAZE_API_KEY=""
WAZE_SYNC_INTERVAL="3600"

# CLOUD STORAGE (AWS S3)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="margrakshak-plans"
